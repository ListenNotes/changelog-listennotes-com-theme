<main class="mt-16 px-4 md:px-8">
  {{#page}}
  <article class="mx-auto mb-8 max-w-3xl">
    <h1 class="mb-8 border-b pb-4 text-2xl font-semibold text-black dark:text-gray-100">{{title}}</h1>
    {{#content_html}}
    <div class="main-text">{{{content_html}}}</div>
    {{/content_html}}
    {{^content_html}}
    <div class="main-text whitespace-pre-line">{{content_text}}</div>
    {{/content_html}}
    {{#is_not_found_page}}
    <p class="mt-8"><a href="/">Back to Listen Notes Changelog</a></p>
    {{/is_not_found_page}}
  </article>
  {{/page}}
</main>
