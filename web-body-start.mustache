<header class="px-4 py-8 md:flex md:items-center md:justify-between md:gap-5 md:px-8">
  <div class="flex min-w-0 items-start gap-5">
    {{#icon}}
    <a href="/" class="relative shrink-0" aria-label="{{title}} home">
      <img class="h-16 w-16 rounded-full bg-white object-cover" src="{{icon}}" width="64" height="64" alt="">
      <span class="absolute inset-0 rounded-full inset-shadow-sm" aria-hidden="true"></span>
    </a>
    {{/icon}}
    <div class="min-w-0 pt-1.5">
      <a href="/" class="text-2xl font-semibold text-black dark:text-gray-100">{{#title}}{{title}}{{/title}}{{^title}}Listen Notes Changelog{{/title}}</a>
      <nav aria-label="Subscribe" class="mt-2 flex flex-wrap gap-x-4 gap-y-2">
        {{#_microfeed.subscribe_methods}}
        <a href="{{url}}" class="flex items-center gap-1 text-sm">
          {{#image}}<img src="{{image}}" class="h-4 w-4 shrink-0 rounded-sm" alt="" loading="lazy">{{/image}}
          <span>{{name}}</span>
        </a>
        {{/_microfeed.subscribe_methods}}
      </nav>
    </div>
  </div>
  <nav aria-label="Listen Notes" class="mt-6 flex shrink-0 flex-wrap items-center gap-4 md:mt-0">
    <div class="flex items-center gap-2">
    <button type="button" aria-label="Search changelog" title="Search changelog" aria-haspopup="dialog" aria-controls="microfeed-search-dialog" data-microfeed-search-open class="inline-flex h-11 w-11 cursor-pointer items-center justify-center rounded-md border border-gray-300 dark:border-gray-700 text-site-link hover:bg-gray-100 dark:hover:bg-gray-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-site-link">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
    </button>
    <button type="button" aria-label="Night mode" aria-pressed="false" title="Switch to night mode" data-theme-toggle class="inline-flex h-11 w-11 cursor-pointer items-center justify-center rounded-md border border-gray-300 dark:border-gray-700 text-site-link hover:bg-gray-100 dark:hover:bg-gray-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-site-link">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.9 13a9 9 0 0 1-9.9-9.9A9 9 0 1 0 20.9 13Z"/></svg>
      <svg xmlns="http://www.w3.org/2000/svg" class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
    </button>
    <a href="https://www.listennotes.com/contact/" target="_blank" rel="noopener noreferrer" aria-label="Contact" title="Contact" class="inline-flex h-11 w-11 items-center justify-center rounded-md border border-gray-300 dark:border-gray-700 text-site-link hover:bg-gray-100 dark:hover:bg-gray-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-site-link">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 6 10 7 10-7"/></svg>
    </a>
    </div>
    <a href="https://www.listennotes.com/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-md bg-brand-500 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:opacity-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-site-link">
      ListenNotes.com
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6M10 14 21 3"/></svg>
    </a>
  </nav>
</header>
