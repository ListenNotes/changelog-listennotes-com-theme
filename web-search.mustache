<main class="mt-16 px-4 md:px-8">
  <section class="mx-auto max-w-3xl">
    <h1 class="mb-8 border-b pb-4 text-2xl font-semibold text-black dark:text-gray-100">Search changelog</h1>
    <form action="/search/" method="get" role="search" data-microfeed-search-scope>
      <label for="site-search" class="mb-2 block font-semibold">Search this site</label>
      <div class="flex items-stretch gap-3">
        <input id="site-search" class="min-w-0 flex-1" name="q" type="search" value="{{search.query}}" placeholder="Search changelog" autocomplete="off" data-microfeed-search-input>
        <button type="submit" class="cursor-pointer rounded-md bg-brand-500 px-4 py-2 font-semibold text-white hover:opacity-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-site-link">Search</button>
      </div>
      <div class="mt-6" aria-live="polite" data-microfeed-search-results data-microfeed-search-details></div>
    </form>
  </section>
</main>
